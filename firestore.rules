rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Global Hardened Primitives
    // ------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || (
            request.auth.token.email == 'c_tokar@chuh.org'
            && request.auth.token.email_verified == true
          )
        );
    }

    // ------------------------------------------------------------------
    // Validation Blueprint: GratitudeNote
    // Mirrors firebase-blueprint.json strictly (name <= 48, message <= 240)
    // ------------------------------------------------------------------
    function isValidGratitudeNote(data) {
      return data.keys().hasAll(['name', 'message', 'createdAt'])
        && data.keys().hasOnly(['name', 'message', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 48
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 240
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // Admin lookup collection (read-only by own UID, no client writes)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Shared Family Gratitude Board
    // Intentionally public (zero-PII) across guest devices; guests may post validated notes;
    // notes are immutable once posted; only verified host admin may delete.
    match /gratitude_notes/{noteId} {
      allow get: if isValidId(noteId);
      allow list: if true;
      allow create: if isValidId(noteId) && isValidGratitudeNote(incoming());
      allow update: if false;
      allow delete: if isValidId(noteId) && isAdmin();
    }
  }
}
